{
  "name": "zh-code-studio",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @zh/backend db:generate",
    "db:migrate": "pnpm --filter @zh/backend db:migrate",
    "start": "pnpm --filter @zh/backend start"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "packageExtensions": {
      "node-pty@*": {
        "dependencies": {
          "node-gyp": "^11.5.0"
        }
      }
    }
  }
}
