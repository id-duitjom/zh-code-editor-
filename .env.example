# ── Backend ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
PREVIEW_DOMAIN=preview.localhost        # origin berasingan untuk preview
SESSION_SECRET=ganti-dengan-32-bytes-random
COOKIE_SECURE=false                     # true dalam production HTTPS

# ── PostgreSQL ───────────────────────────────────────────
DATABASE_URL=postgres://zh:zh@localhost:5432/zhcode

# ── E-mel (contoh: Resend / SMTP) ───────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="ZH Code Studio <no-reply@zhcode.dev>"
APP_BASE_URL=http://localhost:5173

# ── GitHub App (repo peribadi) ───────────────────────────
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
GITHUB_CLIENT_ID=Iv1.xxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxx

# ── Workspace Runner (Docker) ────────────────────────────
DOCKER_SOCKET=/var/run/docker.sock
WORKSPACE_IMAGE=zhcode/workspace:latest
WORKSPACE_IDLE_TIMEOUT_MS=1800000       # 30 min
WORKSPACE_MEMORY_BYTES=1073741824       # 1 GB
WORKSPACE_NANO_CPUS=1000000000          # 1 CPU
WORKSPACE_STORAGE_ROOT=/data/workspaces # volume berterusan